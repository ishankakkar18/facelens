# --- App ---
APP_NAME=FaceLens API

# Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
# Local development (default):
DATABASE_URL=sqlite:///./facelens.db
# MySQL / TiDB example:
# DATABASE_URL=mysql+pymysql://user:password@host:4000/facelens?charset=utf8mb4

# --- AI provider (Google Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Cloudflare R2 (optional; falls back to local ./uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
