# --- App ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PORT=8000

# --- Database ---
# Local dev: leave these unset to use the file-based H2 database.
# Production MySQL/TiDB example:
# SPRING_DATASOURCE_URL=jdbc:mysql://host:4000/facelens?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=user
# SPRING_DATASOURCE_PASSWORD=password

# --- AI provider (Google Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Cloudflare R2 (optional; falls back to local ./uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---
UPLOAD_DIR=uploads
